# ---- Firebase (browser) — Firebase console > Project settings > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (server) — Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole key in quotes, keeping the \n sequences
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Stripe — Developers > API keys (use test keys first)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Created by `npm run stripe:setup`
STRIPE_PRICE_SETUP=price_...
STRIPE_PRICE_HOST_MONTHLY=price_...
STRIPE_PRICE_AGENCY_MONTHLY=price_...

# ---- OpenAI — platform.openai.com/api-keys. Server-only, used for AI-assisted guidebook setup.
OPENAI_API_KEY=

# ---- App
NEXT_PUBLIC_SITE_URL=https://guestsetgo.com
# Comma-separated emails that can open /admin
ADMIN_EMAILS=you@example.com
